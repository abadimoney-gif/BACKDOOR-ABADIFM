--// 4. PHYSICS ENGINE: BLACKHOLE & DUAL RING
local function ForcePart(v)
    if v:IsA("BasePart") and not v.Anchored and not v.Parent:FindFirstChild("Humanoid") then
        if v.Parent == LocalPlayer.Character or v:IsDescendantOf(LocalPlayer.Character) then return end
        for _, x in next, v:GetChildren() do
            if x:IsA("BodyVelocity") or x:IsA("AlignPosition") or x:IsA("Torque") then x:Destroy() end
        end
        v.CanCollide = false
        v.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        table.insert(getgenv().Network.BaseParts, v)
    end
end

